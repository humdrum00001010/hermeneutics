new file mode 100644
index 0000000000000000000000000000000000000000..b32039e02d869c1adb78142584d2b252773b372a
--- /dev/null
+++ b/chrome/browser/extensions/api/messaging/cdp_host.cc
@@ -0,0 +1,141 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/extensions/api/messaging/cdp_host.h"
+
+#include <utility>
+
+#include "base/containers/span.h"
+#include "base/strings/string_view_util.h"
+#include "chrome/browser/extensions/api/messaging/native_message_built_in_host.h"
+#include "content/public/browser/browser_task_traits.h"
+#include "content/public/browser/browser_thread.h"
+#include "extensions/common/constants.h"
+#include "extensions/common/url_pattern.h"
+#include "url/gurl.h"
+
+namespace extensions {
+
+namespace {
+
+const NativeMessageBuiltInHost kDesktopBuiltInHosts[] = {
+    {CdpHost::kHostName, CdpHost::kOrigins, &CdpHost::Create},
+};
+
+bool MatchesSecurityOrigin(const NativeMessageBuiltInHost& host,
+                           const ExtensionId& extension_id) {
+  GURL origin(std::string(kExtensionScheme) + "://" + extension_id);
+  for (const char* host_allowed_origin : host.allowed_origins) {
+    URLPattern allowed_origin(URLPattern::SCHEME_ALL, host_allowed_origin);
+    if (allowed_origin.MatchesSecurityOrigin(origin)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+std::unique_ptr<NativeMessageHost> MaybeCreateBuiltInHost(
+    const ExtensionId& source_extension_id,
+    const std::string& native_host_name,
+    content::BrowserContext* browser_context,
+    std::string* error,
+    bool* handled) {
+  *handled = false;
+  for (const auto& host : kDesktopBuiltInHosts) {
+    if (host.name == native_host_name) {
+      *handled = true;
+      if (MatchesSecurityOrigin(host, source_extension_id)) {
+        return (*host.create_function)(browser_context);
+      }
+      *error = NativeMessageHost::kForbiddenError;
+      return nullptr;
+    }
+  }
+  return nullptr;
+}
+
+// static
+std::unique_ptr<NativeMessageHost> CdpHost::Create(
+    content::BrowserContext* browser_context) {
+  return std::make_unique<CdpHost>();
+}
+
+CdpHost::CdpHost() = default;
+
+CdpHost::~CdpHost() {
+  if (browser_target_) {
+    browser_target_->DetachClient(this);
+    browser_target_.reset();
+  }
+}
+
+void CdpHost::Start(Client* client) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  client_ = client;
+  browser_target_ = content::DevToolsAgentHost::CreateForBrowser(
+      nullptr, content::DevToolsAgentHost::CreateServerSocketCallback());
+  browser_target_->AttachClient(this);
+}
+
+void CdpHost::OnMessage(const std::string& message) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (browser_target_) {
+    browser_target_->DispatchProtocolMessage(this, base::as_byte_span(message));
+  }
+}
+
+scoped_refptr<base::SingleThreadTaskRunner> CdpHost::task_runner() const {
+  return content::GetUIThreadTaskRunner({});
+}
+
+void CdpHost::DispatchProtocolMessage(content::DevToolsAgentHost* agent_host,
+                                      base::span<const uint8_t> message) {
+  if (client_) {
+    client_->PostMessageFromNativeHost(
+        std::string(base::as_string_view(message)));
+  }
+}
+
+void CdpHost::AgentHostClosed(content::DevToolsAgentHost* agent_host) {
+  browser_target_.reset();
+  if (client_) {
+    client_->CloseChannel(NativeMessageHost::kNativeHostExited);
+  }
+}
+
+bool CdpHost::MayAttachToURL(const GURL& url, bool is_webui) {
+  return true;
+}
+
+bool CdpHost::IsTrusted() {
+  return true;
+}
+
+bool CdpHost::MayAccessAllCookies() {
+  return true;
+}
+
+bool CdpHost::MayReadLocalFiles() {
+  return true;
+}
+
+bool CdpHost::MayWriteLocalFiles() {
+  return true;
+}
+
+bool CdpHost::AllowUnsafeOperations() {
+  return true;
+}
+
+bool CdpHost::UsesBinaryProtocol() {
+  return false;
+}
+
+std::string CdpHost::GetTypeForMetrics() {
+  return "RemoteDebugger";
+}
+
+}  // namespace extensions
