+
+namespace content {
+class BrowserContext;
+}
+
+namespace extensions {
+
+class CdpHost : public NativeMessageHost,
+                public content::DevToolsAgentHostClient {
+ public:
+  static constexpr char kHostName[] = "org.hermeneutics.cdp";
+
+  static constexpr const char* kOrigins[] = {
+      "chrome-extension://ahjdebjciejphcmjnfmpnkaelbnhkcnb/"};
+
+  static std::unique_ptr<NativeMessageHost> Create(
+      content::BrowserContext* browser_context);
+
+  CdpHost();
+
+  CdpHost(const CdpHost&) = delete;
+  CdpHost& operator=(const CdpHost&) = delete;
+
+  ~CdpHost() override;
+
+  // NativeMessageHost:
+  void Start(Client* client) override;
+  void OnMessage(const std::string& message) override;
+  scoped_refptr<base::SingleThreadTaskRunner> task_runner() const override;
+
+  // content::DevToolsAgentHostClient:
+  void DispatchProtocolMessage(content::DevToolsAgentHost* agent_host,
+                               base::span<const uint8_t> message) override;
+  void AgentHostClosed(content::DevToolsAgentHost* agent_host) override;
+  bool MayAttachToURL(const GURL& url, bool is_webui) override;
+  bool IsTrusted() override;
+  bool MayAccessAllCookies() override;
+  bool MayReadLocalFiles() override;
+  bool MayWriteLocalFiles() override;
+  bool AllowUnsafeOperations() override;
+  bool UsesBinaryProtocol() override;
+  std::string GetTypeForMetrics() override;
+
+ private:
+  raw_ptr<Client> client_ = nullptr;
+  scoped_refptr<content::DevToolsAgentHost> browser_target_;
+};
+
+// Returns a built-in host when `native_host_name` names one. `*handled` is set
+// when the name matched, in which case a null return means the origin check
+// failed and `*error` has been populated.
+std::unique_ptr<NativeMessageHost> MaybeCreateBuiltInHost(
+    const ExtensionId& source_extension_id,
+    const std::string& native_host_name,
+    content::BrowserContext* browser_context,
+    std::string* error,
+    bool* handled);
+
+}  // namespace extensions
+
+#endif  // CHROME_BROWSER_EXTENSIONS_API_MESSAGING_CDP_HOST_H_
