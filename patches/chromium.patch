+  if (UNSAFE_TODO(pipe(from_host)) != 0) {
+    LOG(ERROR) << "Failed to create the CDP host output pipe";
+    close(to_host[0]);
+    close(to_host[1]);
+    std::move(on_disconnect).Run();
+    return;
+  }
+
+  base::LaunchOptions options;
+  options.fds_to_remap.emplace_back(to_host[0], STDIN_FILENO);
+  options.fds_to_remap.emplace_back(from_host[1], STDOUT_FILENO);
+
+  base::Process process =
+      base::LaunchProcess(base::CommandLine(host_path), options);
+
+  close(to_host[0]);
+  close(from_host[1]);
+
+  if (!process.IsValid()) {
+    LOG(ERROR) << "Failed to launch the CDP host process: " << host_path;
+    close(to_host[1]);
+    close(from_host[0]);
+    std::move(on_disconnect).Run();
+    return;
+  }
+
+  static base::NoDestructor<base::Process> host_process(std::move(process));
+
+  SetDevToolsPipeHandler(std::make_unique<DevToolsPipeHandler>(
+      from_host[0], to_host[1], std::move(on_disconnect),
+      DevToolsPipeHandler::ProtocolMode::kLengthPrefixed));
+#else
+  LOG(ERROR) << "--cdp-host-process is only supported on POSIX";
+  std::move(on_disconnect).Run();
+#endif
+}
