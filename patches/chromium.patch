+class PipeWriterLengthPrefixed : public PipeWriterBase {
+ public:
+  explicit PipeWriterLengthPrefixed(int write_fd) : PipeWriterBase(write_fd) {}
+
+  void WriteIntoPipe(std::string message) override {
+    const uint32_t size =
+        base::HostToNet32(base::checked_cast<uint32_t>(message.size()));
+    WriteBytes(reinterpret_cast<const char*>(&size), sizeof(size));
+    WriteBytes(message.data(), message.size());
+  }
+};
+
+class PipeReaderLengthPrefixed : public PipeReaderBase {
+ public:
+  PipeReaderLengthPrefixed(base::WeakPtr<DevToolsPipeHandler> devtools_handler,
+                           int read_fd)
+      : PipeReaderBase(std::move(devtools_handler), read_fd) {}
+
+ private:
+  static constexpr size_t kHeaderSize = sizeof(uint32_t);
+  static constexpr size_t kChunkSize = 4096;
+  static constexpr size_t kMaxMessageSize = 256 * 1024 * 1024;
+
+  void ReadLoopInternal() override {
+    std::vector<char> chunk(kChunkSize);
+    while (true) {
+      size_t bytes_read = ReadBytes(chunk.data(), chunk.size(), false);
+      if (!bytes_read)
+        break;
+      buffer_.append(chunk.data(), bytes_read);
+
+      while (buffer_.size() >= kHeaderSize) {
+        uint32_t message_size = 0;
+        UNSAFE_TODO(memcpy(&message_size, buffer_.data(), kHeaderSize));
+        message_size = base::NetToHost32(message_size);
+
+        if (message_size > kMaxMessageSize) {
+          LOG(ERROR) << "CDP host sent a message of " << message_size
+                     << " bytes, which exceeds the limit";
+          return;
+        }
+        if (buffer_.size() < kHeaderSize + message_size)
+          break;
+
+        base::span<const uint8_t> body =
+            base::as_byte_span(buffer_).subspan(kHeaderSize, message_size);
+        HandleMessage(std::vector<uint8_t>(body.begin(), body.end()));
+        buffer_.erase(0, kHeaderSize + message_size);
+      }
+    }
+  }
+
+  std::string buffer_;
+};
